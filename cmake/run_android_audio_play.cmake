cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_AUDIO_PLAY_CHUNK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_AUDIO_PLAY_CHUNK}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep original playAudio bytecode under Files")
endif()
file(SHA256 "${chunk}" chunk_hash)
if(NOT chunk_hash STREQUAL
    "f04ab6ad1893a75724a0cc0db2e48d25eef2af77af812cfe330be8a3101dd03b")
    message(FATAL_ERROR "Expected the pinned original playAudio prototype")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    push "${chunk}" /data/local/tmp/ab520/audio-play-oracle.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage playAudio prototype: ${output}${diagnostics}")
endif()
set(AB_ANDROID_ORACLE_KIND audio-play)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
