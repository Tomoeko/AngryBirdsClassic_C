cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_GAME_DRAW_FUNCTION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_GAME_DRAW_FUNCTION}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep the original selected drawGame under Files")
endif()
file(SHA256 "${chunk}" actual)
if(NOT actual STREQUAL
    "9f1c86db2ffe03f2e4df035528586150aa92ad4c93fa5ffbe814b62851f5dcc2")
    message(FATAL_ERROR "Expected pinned drawGame141561 with empty debug upvalue names")
endif()
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/draw-game
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare original drawGame: ${output}${diagnostics}")
endif()
execute_process(COMMAND ${adb} push "${chunk}"
    /data/local/tmp/ab520/draw-game/original.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage original drawGame: ${output}${diagnostics}")
endif()
set(AB_ANDROID_ORACLE_KIND game-draw)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
