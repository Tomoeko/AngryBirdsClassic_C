cmake_minimum_required(VERSION 3.22)
foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_THEME_CHUNK AB_REFERENCE_THEME_BINDING_DATA)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
set(inputs "${AB_REFERENCE_THEME_CHUNK}" "${AB_REFERENCE_THEME_BINDING_DATA}")
set(hashes
    "86df75677d013e4e8f600a32815091421da3aeaa8cf269902528d9f5f7811754"
    "a5060e5221a0b525eba880f9f703a524459030b095dd5ae3c0e64786c9af32b2")
set(names serialized.lua theme1-bindings.bin)
foreach(index RANGE 0 1)
    list(GET inputs ${index} input)
    list(GET hashes ${index} expected_hash)
    list(GET names ${index} name)
    get_filename_component(input "${input}" REALPATH)
    cmake_path(IS_PREFIX private_directory "${input}" NORMALIZE private_input)
    if(NOT private_input)
        message(FATAL_ERROR "Keep original theme scene inputs under Files")
    endif()
    file(SHA256 "${input}" input_hash)
    if(NOT input_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Expected the pinned theme scene input ${name}")
    endif()
    execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
        push "${input}" "/data/local/tmp/ab520/${name}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Theme scene staging failed: ${output}${diagnostics}")
    endif()
endforeach()
if(NOT DEFINED AB_ANDROID_ORACLE_KIND)
    set(AB_ANDROID_ORACLE_KIND theme-scene)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
