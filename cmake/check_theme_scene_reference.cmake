file(SHA256 "${APK}" apk_hash)
if(NOT apk_hash STREQUAL
    "b524b6b4b0ad999f46828546dee1bb047d6e00f724285a2e8c9f4b34a8bee7ad")
    message(FATAL_ERROR "Expected the pinned Angry Birds 5.2.0 APK")
endif()
file(SHA256 "${REFERENCE}" reference_hash)
if(FILL)
    set(expected_hash "64ad3ef2217717c384ae4cfd3c17270673f103831797e6420456aa91fc9cf524")
else()
    set(expected_hash "e5237dd187a1a010a66073b5a6d2541ab33a43b4206a2198dccd66c44aa65f95")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the pinned native theme1 construction/draw graph")
endif()
execute_process(COMMAND "${CHECKER}" "${APK}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native APK theme scene comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
