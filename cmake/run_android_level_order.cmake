cmake_minimum_required(VERSION 3.22)
foreach(required AB_ADB AB_ADB_SERIAL AB_LEVEL_DIRECTORY AB_LEVEL_MANIFEST)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(DIRECTORY "${AB_LEVEL_DIRECTORY}" ABSOLUTE)
cmake_path(IS_PREFIX private_directory "${DIRECTORY}" NORMALIZE private_input)
if(NOT private_input)
    message(FATAL_ERROR "Keep decoded target level constructors under Files")
endif()
set(MANIFEST "${AB_LEVEL_MANIFEST}")
include("${CMAKE_CURRENT_LIST_DIR}/check_level_order_inputs.cmake")
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
set(ENV{ANDROID_USER_HOME} "${private_directory}/android-reference/user")
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/levels
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare native level inputs: ${output}${diagnostics}")
endif()
foreach(first RANGE 0 654 64)
    list(SUBLIST level_files ${first} 64 batch)
    execute_process(COMMAND ${adb} push ${batch} /data/local/tmp/ab520/levels/
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 60)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot copy native level inputs: ${output}${diagnostics}")
    endif()
endforeach()
set(AB_ANDROID_ORACLE_KIND level-order)
set(AB_ANDROID_CHECKER_OPTIONS --levels "${DIRECTORY}")
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
