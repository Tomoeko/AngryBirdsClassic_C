cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_GAME_UPDATE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_GAME_UPDATE}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep original game update under Files")
endif()
file(SHA256 "${chunk}" actual)
if(NOT actual STREQUAL
    "12f4b25e21092af4b3e02e209b68dda64640ed0b72eabc2988462d0edee1aee6")
    message(FATAL_ERROR "Expected the pinned original selected game update")
endif()
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/slingshot
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare original game update: ${output}${diagnostics}")
endif()
execute_process(COMMAND ${adb} push "${chunk}"
    /data/local/tmp/ab520/slingshot/game-update-oracle.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage original game update: ${output}${diagnostics}")
endif()
if(NOT DEFINED AB_ANDROID_ORACLE_KIND)
    set(AB_ANDROID_ORACLE_KIND game-sling-mouse)
elseif(NOT AB_ANDROID_ORACLE_KIND STREQUAL "game-sling-mouse" AND
       NOT AB_ANDROID_ORACLE_KIND STREQUAL "game-update-tail")
    message(FATAL_ERROR "Select the mouse input phase or ordinary game update tail")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_android_slingshot.cmake")
