cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_ROOT_PROTOTYPE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_ROOT_PROTOTYPE}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
file(SHA256 "${chunk}" actual)
if(NOT private_chunk OR NOT actual STREQUAL
    "efc65c333bcd2052139d9cd8a281a88f1d98653378fbae05441533602909f808")
    message(FATAL_ERROR "Expected private original root-update prototype")
endif()
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare original root: ${output}${diagnostics}")
endif()
execute_process(COMMAND ${adb} push "${chunk}" /data/local/tmp/ab520/root-update.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage original root: ${output}${diagnostics}")
endif()
set(AB_ANDROID_ORACLE_KIND root)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
set(REFERENCE "${AB_ANDROID_TRACE}")
include("${CMAKE_CURRENT_LIST_DIR}/check_classic_root_reference.cmake")
