cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_ARM_LIBRARY AB_ANDROID_ORACLE AB_ANDROID_TRACE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
file(SHA256 "${AB_REFERENCE_ARM_LIBRARY}" library_hash)
if(NOT library_hash STREQUAL
    "ada9bc1a1469c30a9bf906c4293df3ff1a75485b40ddbfb146debbc41f14d38c")
    message(FATAL_ERROR "Android reference execution requires the pinned ARMv7 library")
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(trace "${AB_ANDROID_TRACE}" ABSOLUTE)
cmake_path(IS_PREFIX private_directory "${trace}" NORMALIZE private_trace)
if(NOT private_trace)
    message(FATAL_ERROR "Keep Android reference traces under the repository Files directory")
endif()
get_filename_component(trace_directory "${trace}" DIRECTORY)
file(MAKE_DIRECTORY "${trace_directory}")
set(ENV{ANDROID_USER_HOME} "${private_directory}/android-reference/user")
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")

function(run_adb_checked)
    execute_process(COMMAND ${adb} ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Android reference setup failed: ${output}${diagnostics}")
    endif()
endfunction()

run_adb_checked(shell mkdir -p /data/local/tmp/ab520)
run_adb_checked(push "${AB_ANDROID_ORACLE}" /data/local/tmp/ab520/ab_android_oracle)
run_adb_checked(push "${AB_REFERENCE_ARM_LIBRARY}"
    /data/local/tmp/ab520/libAngryBirdsClassic.so)
run_adb_checked(shell chmod 755 /data/local/tmp/ab520/ab_android_oracle)
if(AB_ANDROID_ORACLE_KIND STREQUAL "mighty-eagle-timer")
    if(NOT DEFINED AB_REFERENCE_MIGHTY_EAGLE)
        message(FATAL_ERROR "Supply the pinned original Mighty Eagle module")
    endif()
    get_filename_component(path "${AB_REFERENCE_MIGHTY_EAGLE}" ABSOLUTE)
    cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
    file(SHA256 "${path}" actual)
    if(NOT private_path OR NOT actual STREQUAL
        "564b8a7d3542d5224687b6fd61b140382f8359183d4637af54d2db055f564e42")
        message(FATAL_ERROR "Expected the pinned original Mighty Eagle module")
    endif()
    run_adb_checked(push "${path}" /data/local/tmp/ab520/mighty-eagle.lua)
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "floating-score-draw")
    foreach(kind CLASS HUD)
        set(variable "AB_REFERENCE_FLOATING_${kind}")
        if(NOT DEFINED ${variable})
            message(FATAL_ERROR "Supply ${variable} explicitly")
        endif()
        get_filename_component(path "${${variable}}" ABSOLUTE)
        cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
        file(SHA256 "${path}" actual)
        if(kind STREQUAL "CLASS")
            set(expected "3c35b0b9da93fe13f308c8a3e12dc47cc5fe18a51939b1509de171ee102e4c40")
            set(remote "hud-class.lua")
        else()
            set(expected "2cca717635bd10f8bd14b2b547bdb7378a1491e5c7eb46060b2062582c73eb27")
            set(remote "game-hud.lua")
        endif()
        if(NOT private_path OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "Expected the pinned floating-score ${kind} input")
        endif()
        run_adb_checked(shell mkdir -p /data/local/tmp/ab520/ui)
        run_adb_checked(push "${path}" "/data/local/tmp/ab520/ui/${remote}")
    endforeach()
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "z-order" OR
    AB_ANDROID_ORACLE_KIND STREQUAL "extra-draw")
    if(NOT DEFINED AB_Z_ORDER_COMPARE)
        message(FATAL_ERROR "Supply the private unchanged original z comparator")
    endif()
    get_filename_component(compare_path "${AB_Z_ORDER_COMPARE}" ABSOLUTE)
    cmake_path(IS_PREFIX private_directory "${compare_path}" NORMALIZE private_compare)
    file(SHA256 "${compare_path}" compare_hash)
    if(NOT private_compare OR NOT compare_hash STREQUAL
        "e48d34010f91ae25e2e2bb44437478144221e10217a2bace665dcf8c8b14a965")
        message(FATAL_ERROR "Expected the unchanged pinned original z comparator")
    endif()
    run_adb_checked(push "${compare_path}" /data/local/tmp/ab520/z-order-compare.lua)
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "extra-draw")
    function(stage_extra_reference name expected remote)
        if(NOT DEFINED ${name})
            message(FATAL_ERROR "Supply ${name} explicitly")
        endif()
        get_filename_component(path "${${name}}" ABSOLUTE)
        cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
        file(SHA256 "${path}" actual)
        if(NOT private_path OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "Expected the pinned original ${name}")
        endif()
        run_adb_checked(push "${path}" "${remote}")
    endfunction()
    run_adb_checked(shell mkdir -p /data/local/tmp/ab520/draw-game)
    stage_extra_reference(AB_REFERENCE_GAME_DRAW_FUNCTION
        "9f1c86db2ffe03f2e4df035528586150aa92ad4c93fa5ffbe814b62851f5dcc2"
        /data/local/tmp/ab520/draw-game/original.lua)
    stage_extra_reference(AB_REFERENCE_EXTRA_Z_FUNCTION
        "81a3c1f9850800136ffa7a2db683c814cce2661221714ab3822a33f566f011cc"
        /data/local/tmp/ab520/extra-z-draw.lua)
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "bird-hat")
    foreach(kind create release)
        string(TOUPPER "${kind}" upper)
        set(variable "AB_REFERENCE_${upper}_HAT_FUNCTION")
        if(NOT DEFINED ${variable})
            message(FATAL_ERROR "Supply ${variable} explicitly")
        endif()
        get_filename_component(path "${${variable}}" ABSOLUTE)
        cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
        file(SHA256 "${path}" actual)
        if(kind STREQUAL "create")
            set(expected "cc044aed8a7f05d4771fe7ae2ba92de2db1c9dbf37cb023e8ea77dfa3b2ec6ab")
        else()
            set(expected "5b964577e5b10a6c471140aee4300890c6308f297d96b12463ef4d32748750dc")
        endif()
        if(NOT private_path OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "Expected the unchanged pinned ${kind}Hat function")
        endif()
        run_adb_checked(push "${path}" "/data/local/tmp/ab520/${kind}-hat.lua")
    endforeach()
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "level-clock")
