endif()
string(SUBSTRING "${contents}" 0 ${header_offset} prefix)
if(NOT prefix STREQUAL "" AND NOT prefix STREQUAL
    "WARNING: linker: Unsupported flags DT_FLAGS_1=0x8000000\n")
    message(FATAL_ERROR "Unexpected Android reference startup diagnostic: ${prefix}")
endif()
string(SUBSTRING "${contents}" ${header_offset} -1 corpus)
if(DEFINED completion_marker)
    string(LENGTH "${completion_marker}" marker_length)
    string(LENGTH "${corpus}" corpus_length)
    if(corpus_length LESS marker_length)
        message(FATAL_ERROR "Android reference trace ended before its completion marker")
    endif()
    math(EXPR marker_offset "${corpus_length} - ${marker_length}")
    string(SUBSTRING "${corpus}" ${marker_offset} -1 actual_marker)
    if(NOT actual_marker STREQUAL completion_marker)
        message(FATAL_ERROR "Android reference trace is incomplete")
    endif()
endif()
file(WRITE "${trace}" "${corpus}")
file(SHA256 "${trace}" trace_hash)
file(WRITE "${trace}.sha256" "${trace_hash}\n")
if(AB_PHYSICS_CHECKER)
    execute_process(COMMAND "${AB_PHYSICS_CHECKER}" ${AB_ANDROID_CHECKER_OPTIONS}
        "${trace}" RESULT_VARIABLE check_status
        OUTPUT_VARIABLE check_output ERROR_VARIABLE check_error TIMEOUT 10)
    if(NOT check_status STREQUAL "0")
        message(FATAL_ERROR "Android comparison failed: ${check_output}${check_error}")
    endif()
    message(STATUS "${check_output}")
endif()
file(SHA256 "${trace}.full" raw_hash)
file(WRITE "${trace}.startup.log" "${prefix}")
file(WRITE "${trace}.raw.sha256" "${raw_hash}\n")
file(REMOVE "${trace}.full")
message(STATUS "Android reference trace SHA-256: ${trace_hash}")
