cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_GAME_HUD AB_REFERENCE_GAME_HUD_CLASS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
set(paths "${AB_REFERENCE_GAME_HUD}" "${AB_REFERENCE_GAME_HUD_CLASS}")
set(names game-hud.lua hud-class.lua)
set(hashes
    "2cca717635bd10f8bd14b2b547bdb7378a1491e5c7eb46060b2062582c73eb27"
    "3c35b0b9da93fe13f308c8a3e12dc47cc5fe18a51939b1509de171ee102e4c40")
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/ui
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare original HUD fixture: ${output}${diagnostics}")
endif()
foreach(index RANGE 0 1)
    list(GET paths ${index} path)
    list(GET names ${index} name)
    list(GET hashes ${index} expected)
    get_filename_component(path "${path}" REALPATH)
    cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
    if(NOT private_path)
        message(FATAL_ERROR "Keep original HUD chunks under Files")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected the pinned original HUD ${name} chunk")
    endif()
    execute_process(COMMAND ${adb} push "${path}" "/data/local/tmp/ab520/ui/${name}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot stage original HUD chunk: ${output}${diagnostics}")
    endif()
endforeach()
set(AB_ANDROID_ORACLE_KIND game-hud-draw)
if(AB_GAME_HUD_QUERIES)
    set(AB_ANDROID_ORACLE_KIND game-hud-queries)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
