elseif(EXTENDED)
    set(expected_hash "c5e36e1f127ba5444950f31d7551c00d67c9f5fdb17bb38fff7f289e08efcb51")
else()
    set(expected_hash "0545fe393da5b168c447f714829faf8ce0f81ca97df5afabc3fc35803f770dc8")
