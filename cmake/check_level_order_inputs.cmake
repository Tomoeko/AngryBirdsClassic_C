file(SHA256 "${MANIFEST}" manifest_hash)
if(NOT manifest_hash STREQUAL
    "4f4cfd268ed884ca75918bf6e69d699813155d8f4b81b143286a188a59bef853")
    message(FATAL_ERROR "Expected the pinned 655-level constructor manifest")
endif()
file(READ "${MANIFEST}" manifest)
string(JSON level_count LENGTH "${manifest}" entries)
if(NOT level_count EQUAL 655)
    message(FATAL_ERROR "Expected all 655 target level constructors")
endif()
set(level_files)
foreach(index RANGE 0 654)
    string(JSON name GET "${manifest}" entries ${index} file)
    string(JSON expected_hash GET "${manifest}" entries ${index} sha256)
    file(SHA256 "${DIRECTORY}/${name}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Target level constructor ${index} differs from its pinned hash")
    endif()
    list(APPEND level_files "${DIRECTORY}/${name}")
endforeach()
