file(SHA256 "${REFERENCE}" reference_hash)
if(RESOURCES)
    set(expected_hash "efcec351eb9290aa4f106bdb404c9f25abee92784445fea11ce18247861f4e24")
    set(mode resources)
elseif(ASSETS)
    set(expected_hash "5a4aafb7045b8b26754ce27ede00c3bbc55f731898f84805dabea9e919c67896")
    set(mode assets)
else()
    set(expected_hash "25420a54cbdb9b18124c88abb5416b30ec36b54d2d52e85d31f38269f2fa1f76")
    set(mode catalog)
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded complete native audio-group catalog")
endif()
if(APK)
    file(SHA256 "${APK}" source_hash)
    if(NOT source_hash STREQUAL
        "b524b6b4b0ad999f46828546dee1bb047d6e00f724285a2e8c9f4b34a8bee7ad")
        message(FATAL_ERROR "Expected the pinned reference APK")
    endif()
    set(arguments "--apk-${mode}" "${APK}" "${REFERENCE}")
else()
    file(SHA256 "${DECODED}" source_hash)
    if(NOT source_hash STREQUAL
        "5d1c057fdfdeea7e15bcda6d435848f27a5baf20cf6bb05ac591a822a6c214aa")
        message(FATAL_ERROR "Expected the pinned decoded audio resource")
    endif()
    set(arguments "--${mode}" "${DECODED}" "${REFERENCE}")
