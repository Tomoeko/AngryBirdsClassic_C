file(SHA256 "${APK}" apk_hash)
if(NOT apk_hash STREQUAL
    "b524b6b4b0ad999f46828546dee1bb047d6e00f724285a2e8c9f4b34a8bee7ad")
    message(FATAL_ERROR "Expected the pinned reference APK")
endif()
file(SHA256 "${REFERENCE}" reference_hash)
if(NOT reference_hash STREQUAL
    "0941cae540191c7cda5413f90b4e2fc8dc55143c45e5c583d6d70ce7cddcdef9")
    message(FATAL_ERROR "Expected the recorded native classic object scene")
endif()
set(arguments "${APK}" "${REFERENCE}")
if(POST_REFERENCE)
    file(SHA256 "${POST_REFERENCE}" post_hash)
    if(NOT post_hash STREQUAL
        "cba9fe4987da29d9dcaad6efe4e46da3d5d0333d0dc5dfcb905b395e83db41cf")
        message(FATAL_ERROR "Expected the recorded native classic post-physics inputs")
    endif()
    list(APPEND arguments "${POST_REFERENCE}")
endif()
execute_process(COMMAND "${CHECKER}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native classic scene comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
