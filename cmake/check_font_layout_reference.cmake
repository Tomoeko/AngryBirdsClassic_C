file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "image")
    set(expected_hash "70d550a5df3ddc996eadc61c4b497e0212de5f2145fb904a5612d31f1349c863")
else()
    set(expected_hash "09c40c25172be1499545f56bf69337e120aa312067d0d34f591cbfde2106347c")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded native bitmap-font layout corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native font layout comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
