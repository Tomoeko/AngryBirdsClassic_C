file(SHA256 "${APK}" apk_hash)
file(SHA256 "${REFERENCE}" reference_hash)
if(NOT apk_hash STREQUAL
    "b524b6b4b0ad999f46828546dee1bb047d6e00f724285a2e8c9f4b34a8bee7ad" OR
   NOT reference_hash STREQUAL
    "eebe91cb537840a48484902ac677b2639b2ce5a700ec7e658a6563d10e9373b1")
    message(FATAL_ERROR "Expected the pinned APK and retained native live shot")
endif()
set(checker_arguments "${APK}" "${REFERENCE}")
if(EFFECTS)
    file(SHA256 "${EFFECTS}" effects_hash)
    if(NOT effects_hash STREQUAL
        "965878a8d0d7e207ee39793f32a8ae3f17dd2127ce2acfb973d02ee9ad73e847")
        message(FATAL_ERROR "Expected the recorded ordinary shot effect corpus")
    endif()
    list(APPEND checker_arguments "${EFFECTS}")
endif()
if(WOBBLE)
    if(NOT EFFECTS)
        message(FATAL_ERROR "Sling spring comparison also requires the shot effect corpus")
    endif()
    file(SHA256 "${WOBBLE}" wobble_hash)
    if(NOT wobble_hash STREQUAL
        "210ae24ad65af7c7a6f921a46728b481b5d7f2bdbd8000c12135dd4c924579cf")
        message(FATAL_ERROR "Expected the recorded original sling spring corpus")
    endif()
    list(APPEND checker_arguments "${WOBBLE}")
endif()
if(DRAW)
    if(NOT WOBBLE)
        message(FATAL_ERROR "Draw composition also requires the sling/shot corpora")
    endif()
    file(SHA256 "${DRAW}" draw_hash)
    if(NOT draw_hash STREQUAL
        "1a0ad5e93a526f1050d2c4dce575d61ee69aa3fb459b5e4d3b3bf39115a0efb1")
        message(FATAL_ERROR "Expected the recorded original drawGame corpus")
    endif()
    list(APPEND checker_arguments "${DRAW}")
endif()
execute_process(COMMAND "${CHECKER}" ${checker_arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 60)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Owned shot comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
