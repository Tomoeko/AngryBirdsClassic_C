file(SHA256 "${REFERENCE}" reference_hash)
if(MULTIPLE)
    set(expected_hash "dc0a7be8fd7af66b2ba5606a932828648e0c4f6b0495eb41f7c52f4c3ed3088c")
else()
    set(expected_hash "c2e947bb590a41f24a792ef7fb7edf09b1199e3de6773e914b6cff00ff076c5c")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the original 4096-case equal-rate PCM mixer corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native PCM mixer comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
