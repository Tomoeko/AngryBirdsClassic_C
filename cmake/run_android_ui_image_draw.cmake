cmake_minimum_required(VERSION 3.22)
foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_UI_IMAGE_DRAW_CHUNKS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunks "${AB_REFERENCE_UI_IMAGE_DRAW_CHUNKS}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunks}" NORMALIZE private_chunks)
if(NOT private_chunks)
    message(FATAL_ERROR "Keep original Image draw bytecode under Files")
endif()
file(SHA256 "${chunks}/image-draw-self-oracle.lua" actual)
if(NOT actual STREQUAL
    "73010b2c531fa383fe7130ed105832e965ad15858244fbd418a0a7c181db8c63")
    message(FATAL_ERROR "Expected pinned original Image.drawSelf")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    shell mkdir -p /data/local/tmp/ab520/ui
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare Image draw reference: ${output}${diagnostics}")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    push "${chunks}/image-draw-self-oracle.lua"
        /data/local/tmp/ab520/ui/image-draw-self-oracle.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage Image draw prototype: ${output}${diagnostics}")
endif()
if(AB_UI_IMAGE_RENDER)
    set(AB_ANDROID_ORACLE_KIND ui-image-render)
else()
    set(AB_ANDROID_ORACLE_KIND ui-image-draw)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
