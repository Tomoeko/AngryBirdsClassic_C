file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "startup")
    set(expected_hash "dc31a13052d01ce0365705b1965a7275447e915a286217964c5cf9ad1ba233d8")
    set(options --startup-seed)
elseif(KIND STREQUAL "live")
    set(expected_hash "6ec93ee3b115f862704e8a061c0f74cd634ce46e0f302faf92081f3d05a6b441")
    set(options --live)
else()
    set(expected_hash "1d562e34de4ccffce453a910e7698497875817de95ca171843801e6cc88f1302")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded native random generator/script corpus")
endif()
execute_process(COMMAND "${CHECKER}" ${options} "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native random comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
