file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "script")
    set(expected_hash "3e6c4225df971210c9a320b6647d6d11637dbdd90ddd8ed685c9c23bffa1bbcc")
else()
    set(expected_hash "de3be0f18348145164b6b28867148eefd55268a0e24920e5524a9f62df55b79d")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded Android atan2f component corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native component angle comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
