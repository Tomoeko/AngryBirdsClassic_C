cmake_minimum_required(VERSION 3.22)
foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_UI_MENU_MANAGER_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunks "${AB_REFERENCE_UI_MENU_MANAGER_ROOT}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunks}" NORMALIZE private_chunks)
if(NOT private_chunks)
    message(FATAL_ERROR "Keep original menu controller chunks under Files")
endif()
set(names lua-base class manager)
set(paths ui/lua-base.lua animation/class.lua input/MenuManager.lua)
set(hashes
    "098b3e20b0d84d4f620ac738550e4989ad89180275b56eef2c82bb388b884265"
    "3c35b0b9da93fe13f308c8a3e12dc47cc5fe18a51939b1509de171ee102e4c40"
    "32968381a66b6be69d39a4cff398e99563e1ff4d1596d96d34cf6209607b6c30")
if(AB_MAIN_MENU_THEME OR AB_MAIN_MENU_RESOURCES)
    set(names lua-base class frame main)
    set(paths ui/lua-base.lua animation/class.lua ui/Frame.lua ui/main-menu.lua)
    set(hashes
        "098b3e20b0d84d4f620ac738550e4989ad89180275b56eef2c82bb388b884265"
        "3c35b0b9da93fe13f308c8a3e12dc47cc5fe18a51939b1509de171ee102e4c40"
        "0ada36de30796550e7e72c961c0aa91d8e6ad374ef6efcb74e15bc3237397d9c"
        "37849c38ab19e3abbaf70e8e0eb50c10884fb82d888676ebb37aab8b817b5e42")
endif()
if(AB_MAIN_MENU_RESOURCES)
    list(APPEND names settings themes)
    list(APPEND paths ui/settings-common.lua blocks/themes_new.lua)
    list(APPEND hashes
        "62243daee79c071e52b4cbba7d34a270a1ec656ff478ba1ece8894872f51e554"
        "38e9a721627a591794d260c91b901b0f0ef9140d256cdc62b3eecd2f1a5667b6")
endif()
if(AB_MAIN_MENU_SETTINGS)
    set(names settings)
    set(paths ui/settings-common.lua)
    set(hashes
        "62243daee79c071e52b4cbba7d34a270a1ec656ff478ba1ece8894872f51e554")
endif()
if(AB_UI_MENU_NAVIGATION OR AB_UI_MENU_INPUT OR AB_UI_MENU_KEYS OR AB_UI_MENU_FRAME_KEYS)
    list(APPEND names frame)
    list(APPEND paths ui/Frame.lua)
    list(APPEND hashes
        "0ada36de30796550e7e72c961c0aa91d8e6ad374ef6efcb74e15bc3237397d9c")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    shell mkdir -p /data/local/tmp/ab520/ui
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare menu controller reference: ${output}${diagnostics}")
endif()
list(LENGTH names chunk_count)
math(EXPR last_chunk "${chunk_count} - 1")
foreach(index RANGE 0 ${last_chunk})
    list(GET names ${index} name)
    list(GET paths ${index} relative)
    list(GET hashes ${index} expected)
    set(path "${chunks}/${relative}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected pinned original menu ${name} chunk")
    endif()
    execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
        push "${path}" "/data/local/tmp/ab520/ui/menu-${name}.lua"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot stage menu controller chunk: ${output}${diagnostics}")
    endif()
endforeach()
if(AB_MAIN_MENU_RESOURCES)
    set(AB_ANDROID_ORACLE_KIND main-menu-resources)
elseif(AB_MAIN_MENU_SETTINGS)
    set(AB_ANDROID_ORACLE_KIND main-menu-settings)
elseif(AB_MAIN_MENU_THEME)
    set(AB_ANDROID_ORACLE_KIND main-menu-theme)
elseif(AB_UI_MENU_FRAME_KEYS)
    set(AB_ANDROID_ORACLE_KIND ui-menu-frame-keys)
elseif(AB_UI_MENU_KEYS)
    set(AB_ANDROID_ORACLE_KIND ui-menu-keys)
elseif(AB_UI_MENU_INPUT)
    set(AB_ANDROID_ORACLE_KIND ui-menu-input)
elseif(AB_UI_MENU_NAVIGATION)
    set(AB_ANDROID_ORACLE_KIND ui-menu-navigation)
elseif(AB_UI_MENU_LINKS)
    set(AB_ANDROID_ORACLE_KIND ui-menu-links)
else()
    set(AB_ANDROID_ORACLE_KIND ui-menu-manager)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
