file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "audio")
    set(expected_hash "4cbf04825406728035bc4aba7df84812dc4d49de49e66f2ccf5edd30127a8d03")
elseif(KIND STREQUAL "interval")
    set(expected_hash "daf9c7b663763e38c6d1bb9f7db49ee52ca7f528bf71d5b9a75fb9c492c83def")
elseif(KIND STREQUAL "relative")
    set(expected_hash "d9c92f19e2b15c1981555f819ae0f208c77f2f8bb7218aff572d5142be5b3449")
else()
    set(expected_hash "fdaf13b2c2c1ac7d079ea0a221d74f6305071838b69206c902968d21a670d98e")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded native force-adder corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native force-adder comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
