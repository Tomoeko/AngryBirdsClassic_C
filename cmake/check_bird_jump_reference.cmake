file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "overshoot")
    set(expected_hash "d427615431789c295154fd36261d8bb04e59f36f6c3494db9521d5d9058e1290")
else()
    set(expected_hash "16f14516f96718f91261dfaff1c64c4055e893dbaf41e667d3b34b5a7bdc323c")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded original idle-jump corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Original idle-jump comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
