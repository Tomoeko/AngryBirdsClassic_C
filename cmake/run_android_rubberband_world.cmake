cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_RUBBERBAND_WORLD_CHUNK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_RUBBERBAND_WORLD_CHUNK}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep original rubberband world bytecode under Files")
endif()
file(SHA256 "${chunk}" actual)
if(NOT actual STREQUAL
    "089a31d88948a6fca1263b5d6ba7c24d2186f05d8a539e6d66ec9d80a92125a4")
    message(FATAL_ERROR "Expected the pinned original rubberband world prototype")
endif()
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/ui
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare rubberband world fixture: ${output}${diagnostics}")
endif()
execute_process(COMMAND ${adb} push "${chunk}"
    /data/local/tmp/ab520/ui/rubberband-world-oracle.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage rubberband world prototype: ${output}${diagnostics}")
endif()
set(AB_ANDROID_ORACLE_KIND rubberband-world)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
