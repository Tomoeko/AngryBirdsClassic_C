cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_ANDROID_GPU_EXECUTABLE
        AB_ANDROID_GPU_INPUT AB_ANDROID_GPU_OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
foreach(name AB_ANDROID_GPU_EXECUTABLE AB_ANDROID_GPU_INPUT AB_ANDROID_GPU_OUTPUT)
    get_filename_component(path "${${name}}" ABSOLUTE)
    cmake_path(IS_PREFIX private_directory "${path}" NORMALIZE private_path)
    if(NOT private_path)
        message(FATAL_ERROR "Keep GPU inputs, executable and output under Files")
    endif()
endforeach()
if(EXISTS "${AB_ANDROID_GPU_OUTPUT}" OR EXISTS "${AB_ANDROID_GPU_OUTPUT}.partial")
    message(FATAL_ERROR "Supply a new private GPU output path")
endif()
file(SHA256 "${AB_ANDROID_GPU_INPUT}" input_hash)
set(expected_input "0dd702b176e10ee3c30aac6e7917f49231d35d0da35cae533c9a4bc67d19f18f")
set(expected_output "d9d8f529f63683c91d6a2d61b8e517f796c4d72892636584ba9d489ee86e7f68")
if(AB_ANDROID_GPU_SCENE STREQUAL "sling")
    set(expected_input "aca537e6360c9cffc027fd5c48c82102d2d9879e80519866226564440a1ec14f")
    set(expected_output "8529248e69b4f692156b31fada1cd5aa185eb922e6c2b8f2b1fdd54f3dcbc0cc")
elseif(AB_ANDROID_GPU_SCENE STREQUAL "hud")
    set(expected_input "5245406a570acbfd76f666e4a0a143aa406c2abbadb68c8dba02ecbb5aaf603e")
    set(expected_output "e97f7083c3584336cca2e0f4473407c47752292f29e81dfb0a864279c337f974")
elseif(AB_ANDROID_GPU_SCENE STREQUAL "idle")
    set(expected_input "f9d05d1f325a524560640be797bbcd1cbb0425a6cdb686c6f36dcef2eeb2ccc7")
    set(expected_output "db4eb82467e33995fc153911522f637453719058fbfd65d93c437500f47431c1")
elseif(DEFINED AB_ANDROID_GPU_SCENE AND NOT AB_ANDROID_GPU_SCENE STREQUAL "theme")
    message(FATAL_ERROR "Select the recorded theme, sling, hud or idle scene")
endif()
if(NOT input_hash STREQUAL expected_input)
    message(FATAL_ERROR "Expected the recorded 128-update GPU input for the selected scene")
endif()
get_filename_component(output_directory "${AB_ANDROID_GPU_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
function(run_adb_checked)
    execute_process(COMMAND ${adb} ${ARGV} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Android GPU setup failed: ${output}${diagnostics}")
    endif()
endfunction()

run_adb_checked(shell mkdir -p /data/local/tmp/ab520)
run_adb_checked(push "${AB_ANDROID_GPU_EXECUTABLE}"
    /data/local/tmp/ab520/ab_android_theme_gpu)
run_adb_checked(push "${AB_ANDROID_GPU_INPUT}" /data/local/tmp/ab520/theme-gpu-input.bin)
run_adb_checked(shell chmod 755 /data/local/tmp/ab520/ab_android_theme_gpu)
run_adb_checked(shell rm -f /data/local/tmp/ab520/theme-gpu-output.bin)
execute_process(COMMAND ${adb} exec-out /data/local/tmp/ab520/ab_android_theme_gpu
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 60)
file(WRITE "${AB_ANDROID_GPU_OUTPUT}.log" "${output}${diagnostics}")
string(FIND "${output}" "AB_THEME_GPU_COMPLETE ${input_hash}\n" completed)
if(NOT status STREQUAL "0" OR completed LESS 0)
    message(FATAL_ERROR "Incomplete first-party Android GPU execution: ${status}")
endif()
run_adb_checked(pull /data/local/tmp/ab520/theme-gpu-output.bin
    "${AB_ANDROID_GPU_OUTPUT}.partial")
file(SIZE "${AB_ANDROID_GPU_OUTPUT}.partial" size)
file(SHA256 "${AB_ANDROID_GPU_OUTPUT}.partial" output_hash)
if(NOT size EQUAL 614545 OR NOT output_hash STREQUAL expected_output)
    message(FATAL_ERROR "First-party GPU capture differs from the recorded reference")
endif()
file(RENAME "${AB_ANDROID_GPU_OUTPUT}.partial" "${AB_ANDROID_GPU_OUTPUT}")
message(STATUS "First-party Android GLES2 reproduced all recorded framebuffer bytes")
