file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "live")
    set(expected_hash "eebe91cb537840a48484902ac677b2639b2ce5a700ec7e658a6563d10e9373b1")
else()
    set(expected_hash "ce78d933dc359b096b12b8db2dee7baddd232aaa31841a4fb4b933b84a17cad2")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded original bird-shot reference")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Bird-shot comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
