cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_PROCESS_MANAGER_CHUNK AB_REFERENCE_PROCESS_CLASS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
set(paths "${AB_REFERENCE_PROCESS_MANAGER_CHUNK}" "${AB_REFERENCE_PROCESS_CLASS}")
set(hashes "e141207681fca6790c3761e812b2220158cbe0cfb991a0a5f22ed8644242d89f"
    "3c35b0b9da93fe13f308c8a3e12dc47cc5fe18a51939b1509de171ee102e4c40")
set(names manager class)
set(adb "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}")
execute_process(COMMAND ${adb} shell mkdir -p /data/local/tmp/ab520/process-manager
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot prepare original ProcessManager: ${output}${diagnostics}")
endif()
foreach(index RANGE 0 1)
    list(GET paths ${index} path)
    list(GET hashes ${index} expected)
    list(GET names ${index} name)
    get_filename_component(chunk "${path}" REALPATH)
    cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
    file(SHA256 "${chunk}" actual)
    if(NOT private_chunk OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected private pinned ${name} bytecode")
    endif()
    execute_process(COMMAND ${adb} push "${chunk}"
        "/data/local/tmp/ab520/process-manager/${name}.lua"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot stage original process ${name}: ${output}${diagnostics}")
    endif()
endforeach()
set(AB_ANDROID_ORACLE_KIND process-manager)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
