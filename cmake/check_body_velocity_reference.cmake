file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "angular")
    set(expected_hash "dc93f7a2f1f5ea753f4f2e15249a64500ba4bdcd2f37f00a3ad0f7b92063b47e")
else()
    set(expected_hash "af87bcdfdda30cfb6d1227b4fdda46e4f3ce9f29036f4b7f63ada16302573e80")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded native GameLua body velocity corpus")
endif()
execute_process(COMMAND "${CHECKER}" "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native velocity/impulse comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
