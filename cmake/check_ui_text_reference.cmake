    set(expected_hash "72e6df649cf34b1807b49c4fb16cfa47964eaf6a135025d127e73e3c0b8e4f1f")
else()
    set(expected_hash "3ce9047f9e07c354c83f133485f21782c03dcfe7fb403ac5888f960f67671fb1")
