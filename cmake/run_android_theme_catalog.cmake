cmake_minimum_required(VERSION 3.22)
foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_THEME_CHUNK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_THEME_CHUNK}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep original theme chunks under Files")
endif()
file(SHA256 "${chunk}" chunk_hash)
if(NOT chunk_hash STREQUAL
    "86df75677d013e4e8f600a32815091421da3aeaa8cf269902528d9f5f7811754")
    message(FATAL_ERROR "Expected the pinned complete classic themes chunk")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    push "${chunk}" /data/local/tmp/ab520/serialized.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Theme catalog staging failed: ${output}${diagnostics}")
endif()
set(AB_ANDROID_ORACLE_KIND lua-data)
include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
