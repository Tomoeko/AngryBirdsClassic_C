file(SHA256 "${REFERENCE}" reference_hash)
if(KIND STREQUAL "state")
    set(expected_hash "3f42f43c65129ed838d198c4f99c7c47c5175982618e63f8a8bae74c72140640")
    set(options --state)
else()
    set(expected_hash "7301ff641a266ddae2b0087597bf72a065af4cd28c5937b3f179a96e990c77ff")
endif()
if(NOT reference_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Expected the recorded native object sprite corpus")
endif()
execute_process(COMMAND "${CHECKER}" ${options} "${REFERENCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Native object sprite comparison failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
