file(SHA256 "${APK}" apk_hash)
if(NOT apk_hash STREQUAL
    "b524b6b4b0ad999f46828546dee1bb047d6e00f724285a2e8c9f4b34a8bee7ad")
    message(FATAL_ERROR "Expected the pinned Angry Birds 5.2.0 APK")
endif()
set(arguments "${APK}")
if(REFERENCE)
    file(SHA256 "${REFERENCE}" reference_hash)
    if(NOT reference_hash STREQUAL
        "b6cefb4845ae54d591d146e59a4474cabf43eb2b9b07576199beeaa045546a95")
        message(FATAL_ERROR "Expected original main-menu settings/theme resource corpus")
    endif()
    list(APPEND arguments "${REFERENCE}")
endif()
execute_process(COMMAND "${CHECKER}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "APK main-menu resources failed: ${output}${diagnostics}")
endif()
message(STATUS "${output}")
