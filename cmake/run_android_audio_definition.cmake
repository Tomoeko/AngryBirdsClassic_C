cmake_minimum_required(VERSION 3.22)

foreach(required AB_ADB AB_ADB_SERIAL AB_REFERENCE_AUDIO_DEFINITION_CHUNK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Supply ${required} explicitly")
    endif()
endforeach()
if(NOT DEFINED AB_ADB_PORT)
    set(AB_ADB_PORT 5041)
endif()
get_filename_component(private_directory "${CMAKE_CURRENT_LIST_DIR}/../Files" REALPATH)
get_filename_component(chunk "${AB_REFERENCE_AUDIO_DEFINITION_CHUNK}" REALPATH)
cmake_path(IS_PREFIX private_directory "${chunk}" NORMALIZE private_chunk)
if(NOT private_chunk)
    message(FATAL_ERROR "Keep original audio definition bytecode under Files")
endif()
file(SHA256 "${chunk}" chunk_hash)
if(NOT chunk_hash STREQUAL
    "85120df0c2f30178ed4a54ea3ff85d92f110292f3d0e52fb74db27127111c2e6")
    message(FATAL_ERROR "Expected the pinned original createAudio prototype")
endif()
execute_process(COMMAND "${AB_ADB}" -P "${AB_ADB_PORT}" -s "${AB_ADB_SERIAL}"
    push "${chunk}" /data/local/tmp/ab520/audio-definition-oracle.lua
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot stage audio definition: ${output}${diagnostics}")
endif()
if(NOT DEFINED AB_ANDROID_ORACLE_KIND)
    set(AB_ANDROID_ORACLE_KIND audio-definition)
endif()
if(AB_ANDROID_ORACLE_KIND STREQUAL "audio-resources")
    include("${CMAKE_CURRENT_LIST_DIR}/run_android_audio_catalog.cmake")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/run_android_oracle.cmake")
endif()
